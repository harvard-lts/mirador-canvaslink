    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "jsdom": "^27.4.0",
    "mirador": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.8.3",
